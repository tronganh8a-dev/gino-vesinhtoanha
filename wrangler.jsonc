{
  "name": "gino-vesinhtoanha",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Phiên đăng nhập: mỗi tài khoản 1 thiết bị + chặn đoán mật khẩu (Durable Object SQLite — gói miễn phí dùng được)
  "durable_objects": { "bindings": [{ "name": "SESS", "class_name": "Sessions" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sessions"] }],
  "keep_vars": true,
  "workers_dev": true
}
